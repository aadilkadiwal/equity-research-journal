---
import Base from '../layouts/Base.astro';
import data from '../data/companies.json';
import emas from '../data/emas.json';
import { VIEW_ORDER, VIEW_GLYPH, initialListHTML, viewCounts, quarterBuckets, newestQuarter, digestCounts } from '../lib/render.js';

// Attach the weekly-EMA record (10/20/40W + % distance) to each company by slug.
// Refreshed daily by .github/workflows/refresh-emas.yml; absent entries just
// render no panel.
const companies = data.companies.map((c) => ({ ...c, ema: (emas.companies || {})[c.slug] || null }));
const industries = [...new Set(companies.map((c) => c.industry).filter(Boolean))].sort();
const tiers = ['Tier 1', 'Tier 2', 'Tier 3', 'Tier 4'];
// Quarter options, newest first, each labelled with how many companies' CURRENT
// view comes from it. A company revisited later belongs to the newer bucket
// only, so these counts partition the book rather than overlapping.
const quarters = quarterBuckets(companies);

const viewDots = {
  Positive: 'var(--view-positive-bar)', Watch: 'var(--view-watch-bar)',
  Concern: 'var(--view-concern-bar)', Negative: 'var(--view-negative-bar)',
};
const VIEW_MEANING = {
  Positive: 'looks promising', Watch: 'keep an eye on',
  Concern: 'be cautious', Negative: 'avoid for now',
};

const counts = viewCounts(companies);
const newestQ = newestQuarter(companies);
// Every company lands in exactly one digest bucket, so the five counts partition
// the book and each can drive a filter.
const dg = digestCounts(companies);
const initialRows = initialListHTML(companies, 24);
---
<Base title="Aadil Kadiwal · Equity Research & Views">
  <!-- Title and legend share one line on desktop; stacked they cost 161px of
       every visit for information that fits in 52. -->
  <div class="topbar">
    <section class="hero">
      <h1 class="hero-title">Equity Research &amp; Views</h1>
    </section>

    <section class="view-summary" aria-label="View distribution across all companies">
      <div class="vs-bar">
        {VIEW_ORDER.filter((v) => counts[v] > 0).map((v) => (
          <span class={`vs-seg view-${v.toLowerCase()}`} style={`flex:${counts[v]}`} title={`${v}: ${counts[v]}`}></span>
        ))}
      </div>
      <div class="vs-legend">
        {VIEW_ORDER.map((v) => (
          <span class="vs-item">
            <span class="gly" style={`color:${viewDots[v]}`}>{VIEW_GLYPH[v]}</span>
            <b>{v}</b> <span class="vs-meaning">{VIEW_MEANING[v]}</span> <span class="vs-n">{counts[v]}</span>
          </span>
        ))}
      </div>
      <!-- On a phone the meanings move behind the ⓘ and the counts stay: 85px → 22px. -->
      <div class="vs-compact">
        {VIEW_ORDER.map((v) => (
          <span class={`vsc view-${v.toLowerCase()}`}><span class="gly">{VIEW_GLYPH[v]}</span>{counts[v]}</span>
        ))}
        <button class="vsc-i" id="vs-info" title="Positive = looks promising · Watch = keep an eye on · Concern = be cautious · Negative = avoid for now">i</button>
      </div>
    </section>
  </div>

  <!-- Counts only. Pressing a pill filters the list, which shows those companies
       as full cards or rows — better than a cramped column of names. A <details>
       could not do this: a <summary> swallows clicks on its own children. -->
  <section class="digest" aria-label={`What changed in ${newestQ}`}>
    <div class="dg-bar">
      <span class="dg-title">What changed in <b>{newestQ}</b></span>
      <div class="dg-pills" id="dg-pills">
        <button class="qp up" data-change="up" aria-pressed="false"><span class="n">{dg.up}</span>↑ upgraded</button>
        <button class="qp down" data-change="down" aria-pressed="false" aria-disabled={dg.down === 0 ? 'true' : 'false'}><span class="n">{dg.down}</span>↓ downgraded</button>
        <button class="qp new" data-change="new" aria-pressed="false"><span class="n">{dg.new}</span>+ newly covered</button>
      </div>
    </div>
  </section>

  <!-- One toolbar at every width: a row that is always visible, and one panel
       behind Filters. Replaces the old two-row desktop toolbar. -->
  <div class="tbar-wrap">
    <div class="tbar">
      <input class="search" id="search" type="search" placeholder="Search company name or symbol…" autocomplete="off" />
      <button class="fbtn" id="fbtn" aria-expanded="false" aria-controls="tpanel">Filters<span class="fbtn-n" id="fbtn-n" hidden></span><span class="cv">▾</span></button>
      <span class="dens">
        <span class="segmented" role="tablist" aria-label="Density">
          <button class="seg" data-density="cards" aria-selected="true"><span class="ic">▦</span>Cards</button>
          <button class="seg" data-density="table" aria-selected="false"><span class="ic">☰</span>Table</button>
        </span>
      </span>
      <button class="btn ghost" id="export" title="Download the filtered list as an NSE:SYMBOL watchlist">⬇ Watchlist</button>
    </div>

    <div class="tpanel" id="tpanel" hidden>
      <p class="tp-lab">Narrow by</p>
      <div class="tp-grid">
        <select id="industry" aria-label="Filter by industry" data-dd="Search industry…">
          <option value="">All industries</option>
          {industries.map((s) => <option value={s}>{s}</option>)}
        </select>
        <select id="quarter" aria-label="Filter by quarter" data-dd>
          <option value="" data-count={String(companies.length)}>All Quarter</option>
          {quarters.map((q) => <option value={q.quarter} data-count={String(q.count)}>{q.quarter}</option>)}
        </select>
        <select id="tier" aria-label="Filter by tier" data-dd data-note="tier-note-tpl">
          <option value="">All tiers</option>
          {tiers.map((t) => <option value={t}>{t}</option>)}
        </select>
        <select class="sort" id="sort" aria-label="Sort by" data-dd>
          <option value="view" selected>Sort: View · newest first</option>
          <option value="mcap">Sort: Market cap</option>
          <option value="name">Sort: Name A–Z</option>
          <option value="tier">Sort: Tier</option>
        </select>
      </div>
      <template id="tier-note-tpl">
        <div class="dd-note">
          <b>Tier</b> = the weaker of YoY Sales &amp; PAT growth
          <ul>
            <li><b>Tier 1</b> — both ≥ 20%</li>
            <li><b>Tier 2</b> — both ≥ 15% (under 20)</li>
            <li><b>Tier 3</b> — both ≥ 10% (under 15)</li>
            <li><b>Tier 4</b> — either &lt; 10%</li>
          </ul>
        </div>
      </template>

      <div class="tp-two">
        <div>
          <p class="tp-lab">View</p>
          <div class="chips" id="view-chips">
            {VIEW_ORDER.map((v) => (
              <button class="chip" data-view={v} aria-pressed="false">
                <span class="gly" style={`color:${viewDots[v]}`}>{VIEW_GLYPH[v]}</span>{v}<span class="n" data-count></span>
              </button>
            ))}
          </div>
        </div>
        <div>
          <p class="tp-lab">Near an EMA (≤2%)</p>
          <div class="ema-tools" id="ema-tools">
            <button class="chip" data-ema="near10" aria-pressed="false" title="Price within 2% of the 10-week EMA">10W</button>
            <button class="chip" data-ema="near20" aria-pressed="false" title="Price within 2% of the 20-week EMA">20W</button>
            <button class="chip" data-ema="near40" aria-pressed="false" title="Price within 2% of the 40-week EMA">40W</button>
            <button class="chip" data-ema="converge" aria-pressed="false" title="10 / 20 / 40-week EMAs bunched together (≤5% apart)">⇉ Converging EMAs</button>
          </div>
        </div>
      </div>

      <div class="tp-foot">
        <button class="btn ghost tp-mob" id="export-m">⬇ Watchlist</button>
        <button class="token-reset" id="reset-panel">↺ Reset all</button>
      </div>
    </div>
  </div>

  <div class="active-filters" id="active-filters"></div>
  <!-- The results line hosts the density switch on a phone, where the toolbar
       row has no space for it: ~4px instead of ~40. -->
  <div class="count-row">
    <p class="count" id="count"></p>
    <span class="dens">
      <span class="segmented" role="tablist" aria-label="Density">
        <button class="seg" data-density="cards" aria-selected="true"><span class="ic">▦</span>Cards</button>
        <button class="seg" data-density="table" aria-selected="false"><span class="ic">☰</span>Table</button>
      </span>
    </span>
  </div>

  <div class="list" id="list" set:html={initialRows}></div>
  <div id="tblhost"></div>
  <div class="empty-state" id="empty" style="display:none">
    No companies match your filters. <button class="btn ghost" id="clear-empty">↺ Reset</button>
  </div>
  <nav class="pager" id="pager" aria-label="Pagination"></nav>

  <script type="application/json" id="dataset" set:html={JSON.stringify(companies).replace(/</g, '\\u003c')}></script>
</Base>

<script>
  import { rowHTML, tableRowHTML, tableHTML, latestEntry, newestQuarter, changeClass, VIEW_GLYPH, viewRank, esc } from '../lib/render.js';
  import { quarterKey } from '../lib/format.js';

  const DATA = JSON.parse(document.getElementById('dataset').textContent);
  const NEWEST_Q = newestQuarter(DATA);

  const listEl = document.getElementById('list');
  const searchEl = document.getElementById('search');
  const sortEl = document.getElementById('sort');
  const quarterEl = document.getElementById('quarter');
  const tierEl = document.getElementById('tier');
  const industryEl = document.getElementById('industry');
  const countEl = document.getElementById('count');
  const emptyEl = document.getElementById('empty');
  const chipsEl = document.getElementById('view-chips');
  const exportBtn = document.getElementById('export');
  const activeFiltersEl = document.getElementById('active-filters');
  const pagerEl = document.getElementById('pager');
  const tblHost = document.getElementById('tblhost');
  const pillsEl = document.getElementById('dg-pills');
  const fbtn = document.getElementById('fbtn');
  const fbtnN = document.getElementById('fbtn-n');
  const tpanel = document.getElementById('tpanel');

  const emaToolsEl = document.getElementById('ema-tools');
  const activeViews = new Set();
  const activeEma = new Set();
  // Which digest bucket is filtering, if any. Single-select: the five buckets
  // partition the book, so combining them would always give an empty set.
  let activeChange = null;
  // Cards are tall, so phones get half as many. Table rows are the same height
  // everywhere, so 50 holds at both widths.
  const mqMobile = window.matchMedia('(max-width: 640px)');
  let density = document.documentElement.getAttribute('data-density') === 'table' ? 'table' : 'cards';
  const pageSize = () => (density === 'table' ? 50 : (mqMobile.matches ? 12 : 24));
  let PAGE_SIZE = pageSize();
  let currentPage = 1;
  let lastVisible = [];

  // Rank by the tier shown on the card (latest quarter), not the company-level
  // field, so the sort order matches what's rendered.
  const tierRank = (c) => { const m = /(\d)/.exec((c._latest && c._latest.tier) || c.tier || ''); return m ? +m[1] : 9; };

  // Search matches company name and symbol (tvCode) only — not industry or
  // notes. Use the industry/tier dropdowns to narrow by those.
  const haystack = (c) => {
    if (c._haystack == null) {
      c._haystack = `${c.name} ${c.tvCode || ''}`.toLowerCase();
    }
    return c._haystack;
  };
  function matches(c, term) {
    return haystack(c).includes(term);
  }

  function apply() {
    const term = searchEl.value.trim().toLowerCase();
    const quarter = quarterEl.value;
    const tier = tierEl.value;
    const industry = industryEl.value;

    // Resolve each company's latest quarter once per pass and cache it on the
    // object — filter, counts, view-filter and the sort comparators all reuse it
    // instead of re-reducing the timeline every time.
    const base = DATA.filter((c) => {
      c._latest = latestEntry(c);
      if (!c._latest) return false;
      // Quarter = where a company's CURRENT view comes from, so the buckets
      // partition the book: one revisited later drops out of the older bucket.
      if (quarter && c._latest.quarter !== quarter) return false;
      if (term && !matches(c, term)) return false;
      // Match the tier shown on the card (latest quarter), not the company field.
      if (tier && (c._latest.tier || c.tier) !== tier) return false;
      if (industry && c.industry !== industry) return false;
      if (activeChange && changeClass(c, NEWEST_Q) !== activeChange) return false;
      return true;
    });

    const counts = { Positive: 0, Watch: 0, Concern: 0, Negative: 0 };
    base.forEach((c) => { const v = c._latest.view; if (counts[v] != null) counts[v]++; });
    chipsEl.querySelectorAll('.chip').forEach((chip) => {
      chip.querySelector('[data-count]').textContent = ' ' + (counts[chip.dataset.view] ?? 0);
    });

    let visible = base.filter((c) => activeViews.size === 0 || activeViews.has(c._latest.view));

    // EMA screening: keep only companies matching every active "vs EMA" chip.
    // "Near" = price within NEAR% of that weekly EMA. "Converging" = the three
    // EMAs are bunched within CONVERGE% of each other (a weekly squeeze).
    if (activeEma.size) {
      const NEAR = 2, CONVERGE = 5;
      const near = (r, w) => { const v = r.dist && r.dist[w]; return v != null && Math.abs(v) <= NEAR; };
      visible = visible.filter((c) => {
        const r = c.ema;
        if (!r) return false;
        if (activeEma.has('near10') && !near(r, '10W')) return false;
        if (activeEma.has('near20') && !near(r, '20W')) return false;
        if (activeEma.has('near40') && !near(r, '40W')) return false;
        if (activeEma.has('converge') && !(r.spread != null && r.spread <= CONVERGE)) return false;
        return true;
      });
    }

    const sort = sortEl.value;
    const byCap = (a, b) => (b.marketCap || 0) - (a.marketCap || 0);
    // Newest quarter first, so within each view band the freshest thinking
    // surfaces above views that haven't been revisited.
    const byQuarter = (a, b) => quarterKey(b._latest.quarter) - quarterKey(a._latest.quarter);
    if (sort === 'name') visible.sort((a, b) => a.name.localeCompare(b.name));
    else if (sort === 'tier') visible.sort((a, b) => (tierRank(a) - tierRank(b)) || byCap(a, b));
    // Keep these three keys in lockstep with initialListHTML() in render.js —
    // a mismatch reorders the SSR'd first page the moment this script runs.
    else if (sort === 'view') visible.sort((a, b) => (viewRank(a._latest.view) - viewRank(b._latest.view)) || byQuarter(a, b) || byCap(a, b));
    else visible.sort(byCap);

    lastVisible = visible;
    currentPage = 1;
    renderPage();
    renderActiveFilters(term, quarter, tier, industry);
  }

  const CHANGE_LABEL = { up: 'upgraded', down: 'downgraded', new: 'newly covered' };

  function renderPage() {
    const total = lastVisible.length;
    PAGE_SIZE = pageSize();
    const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (currentPage > pages) currentPage = pages;
    const start = (currentPage - 1) * PAGE_SIZE;
    const slice = lastVisible.slice(start, start + PAGE_SIZE);
    const entry = (c) => c._latest || latestEntry(c);
    if (density === 'table') {
      tblHost.innerHTML = tableHTML(slice.map((c) => tableRowHTML(c, entry(c), NEWEST_Q)).join(''));
      listEl.innerHTML = '';
    } else {
      listEl.innerHTML = slice.map((c) => rowHTML(c, entry(c), NEWEST_Q)).join('');
      tblHost.innerHTML = '';
    }
    emptyEl.style.display = total === 0 ? '' : 'none';
    // The bucket name lands here rather than in the pill, where it would be long.
    const suffix = activeChange ? ` · ${CHANGE_LABEL[activeChange]}` : '';
    countEl.innerHTML = total === 0
      ? '0 companies'
      : `Showing <b>${start + 1}–${start + slice.length}</b> of <b>${total}</b>${suffix}`;
    renderPagination(pages);
  }

  function pageWindow(cur, pages) {
    const out = [];
    for (let i = 1; i <= pages; i++) {
      if (i === 1 || i === pages || (i >= cur - 1 && i <= cur + 1)) out.push(i);
      else if (out[out.length - 1] !== '…') out.push('…');
    }
    return out;
  }

  function renderPagination(pages) {
    if (pages <= 1) { pagerEl.innerHTML = ''; return; }
    let html = `<button class="pg-btn" data-pg="prev" ${currentPage === 1 ? 'disabled' : ''}>‹ Prev</button>`;
    for (const p of pageWindow(currentPage, pages)) {
      html += p === '…' ? `<span class="pg-gap">…</span>` : `<button class="pg-btn pg-num${p === currentPage ? ' active' : ''}" data-pg="${p}">${p}</button>`;
    }
    html += `<button class="pg-btn" data-pg="next" ${currentPage === pages ? 'disabled' : ''}>Next ›</button>`;
    html += `<span class="pg-size">${PAGE_SIZE} per page</span>`;
    pagerEl.innerHTML = html;
  }

  function goToPage(p) {
    const pages = Math.max(1, Math.ceil(lastVisible.length / PAGE_SIZE));
    if (p === 'prev') p = currentPage - 1; else if (p === 'next') p = currentPage + 1; else p = parseInt(p, 10);
    currentPage = Math.min(Math.max(1, p), pages);
    renderPage();
    document.querySelector('.tbar-wrap').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderActiveFilters(term, quarter, tier, industry) {
    // Faceted chips: each carries its category (kicker or, for views, a coloured
    // glyph) so you can read WHAT is filtered at a glance, not just the value.
    const tokens = [];
    if (term) tokens.push({ type: 'search', cat: 'Search', label: term });
    if (quarter) tokens.push({ type: 'quarter', cat: 'Quarter', label: quarter });
    [...activeViews].forEach((v) => tokens.push({ type: 'view', val: v, label: v, cls: `view-${v.toLowerCase()}`, gly: VIEW_GLYPH[v] }));
    if (tier) tokens.push({ type: 'tier', cat: 'Tier', label: tier.replace(/^Tier\s*/i, '') });
    if (industry) tokens.push({ type: 'industry', cat: 'Industry', label: industry });
    if (activeChange) tokens.push({ type: 'change', val: activeChange, cat: 'Changed', label: CHANGE_LABEL[activeChange] });
    const emaShort = { near10: 'Near 10W', near20: 'Near 20W', near40: 'Near 40W', converge: 'Converging' };
    [...activeEma].forEach((k) => tokens.push({ type: 'ema', val: k, cat: 'EMA', label: emaShort[k] }));
    // "Dirty" = any filter OR a non-default sort — so Reset also surfaces when
    // only the sort was changed (Reset returns sort to View too).
    const dirty = tokens.length || sortEl.value !== 'view';
    // The button carries a count so a collapsed panel never hides that filters
    // are on. Search and the digest bucket live outside the panel, so they don't.
    const inPanel = tokens.filter((t) => t.type !== 'search' && t.type !== 'change').length
      + (sortEl.value !== 'view' ? 1 : 0);
    fbtnN.hidden = inPanel === 0;
    fbtnN.textContent = String(inPanel);
    if (!dirty) { activeFiltersEl.innerHTML = ''; return; }
    const chip = (t) => {
      const lead = t.gly ? `<span class="tk-gly">${t.gly}</span>`
        : (t.cat ? `<span class="tk-cat">${esc(t.cat)}</span>` : '');
      return `<button class="token token-${t.type}${t.cls ? ' ' + t.cls : ''}" data-type="${t.type}" data-val="${esc(t.val || '')}" title="Remove this filter">`
        + `${lead}<span class="tk-val">${esc(t.label)}</span><span class="x" aria-hidden="true">✕</span></button>`;
    };
    activeFiltersEl.innerHTML =
      `<span class="af-lead">Filters</span>` +
      tokens.map(chip).join('') +
      `<button class="token-reset" id="reset" title="Reset all filters and sort to default">↺ Reset</button>`;
  }

  function clearAll() {
    searchEl.value = ''; quarterEl.value = ''; tierEl.value = ''; industryEl.value = '';
    sortEl.value = 'view';                    // back to the default sort
    activeViews.clear();
    activeEma.clear();
    activeChange = null;
    pillsEl.querySelectorAll('.qp').forEach((p) => p.setAttribute('aria-pressed', 'false'));
    chipsEl.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
    emaToolsEl.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
    dropdowns.forEach((d) => d.repaint());   // resync custom-dropdown labels to the reset <select>s
    apply();
  }

  // ---- toast + deep-link anchors ----
  let toastEl;
  function toast(msg) {
    if (!toastEl) { toastEl = document.createElement('div'); toastEl.className = 'toast'; document.body.appendChild(toastEl); }
    toastEl.textContent = msg; toastEl.classList.add('show');
    clearTimeout(toast._t); toast._t = setTimeout(() => toastEl.classList.remove('show'), 1500);
  }
  function flashRow(slug) {
    const el = document.getElementById('c-' + slug);
    if (!el) return false;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.classList.add('row-flash');
    setTimeout(() => el.classList.remove('row-flash'), 1600);
    return true;
  }
  function handleHash() {
    const ch = /^#changed=(up|down|new)$/.exec(location.hash);
    if (ch) {
      activeChange = ch[1];
      pillsEl.querySelectorAll('.qp').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.change === activeChange)));
      apply();
      return;
    }
    const m = /^#c-(.+)$/.exec(location.hash);
    if (!m) return;
    const slug = decodeURIComponent(m[1]);
    if (!DATA.some((c) => c.slug === slug)) return;
    // make sure it's on the current filtered set + right page
    if (!lastVisible.some((c) => c.slug === slug)) clearAll();
    const idx = lastVisible.findIndex((c) => c.slug === slug);
    if (idx >= 0) { currentPage = Math.floor(idx / PAGE_SIZE) + 1; renderPage(); }
    setTimeout(() => flashRow(slug), 60);
  }

  // events
  // Debounce search so each keystroke doesn't trigger a full filter+sort+rebuild.
  let searchDebounce;
  searchEl.addEventListener('input', () => { clearTimeout(searchDebounce); searchDebounce = setTimeout(apply, 140); });
  sortEl.addEventListener('change', apply);
  quarterEl.addEventListener('change', apply);
  tierEl.addEventListener('change', apply);
  industryEl.addEventListener('change', apply);

  chipsEl.addEventListener('click', (e) => {
    const chip = e.target.closest('.chip');
    if (!chip) return;
    const v = chip.dataset.view;
    if (activeViews.has(v)) { activeViews.delete(v); chip.setAttribute('aria-pressed', 'false'); }
    else { activeViews.add(v); chip.setAttribute('aria-pressed', 'true'); }
    apply();
  });

  emaToolsEl.addEventListener('click', (e) => {
    const chip = e.target.closest('.chip');
    if (!chip) return;
    const k = chip.dataset.ema;
    if (activeEma.has(k)) { activeEma.delete(k); chip.setAttribute('aria-pressed', 'false'); }
    else { activeEma.add(k); chip.setAttribute('aria-pressed', 'true'); }
    apply();
  });

  activeFiltersEl.addEventListener('click', (e) => {
    if (e.target.closest('#reset')) return clearAll();
    const tok = e.target.closest('.token');
    if (!tok) return;
    const { type, val } = tok.dataset;
    if (type === 'search') searchEl.value = '';
    else if (type === 'quarter') { quarterEl.value = ''; quarterEl.dispatchEvent(new Event('change', { bubbles: true })); }
    else if (type === 'tier') { tierEl.value = ''; tierEl.dispatchEvent(new Event('change', { bubbles: true })); }
    else if (type === 'industry') { industryEl.value = ''; industryEl.dispatchEvent(new Event('change', { bubbles: true })); }
    else if (type === 'view') { activeViews.delete(val); chipsEl.querySelector(`.chip[data-view="${val}"]`)?.setAttribute('aria-pressed', 'false'); }
    else if (type === 'ema') { activeEma.delete(val); emaToolsEl.querySelector(`.chip[data-ema="${val}"]`)?.setAttribute('aria-pressed', 'false'); }
    else if (type === 'change') { activeChange = null; pillsEl.querySelectorAll('.qp').forEach((p) => p.setAttribute('aria-pressed', 'false')); }
    apply();
  });

  document.getElementById('clear-empty').addEventListener('click', clearAll);
  document.getElementById('reset-panel').addEventListener('click', clearAll);
  document.getElementById('export-m').addEventListener('click', () => exportBtn.click());

  fbtn.addEventListener('click', () => {
    const open = tpanel.hasAttribute('hidden');
    tpanel.toggleAttribute('hidden', !open);
    fbtn.setAttribute('aria-expanded', String(open));
  });

  pillsEl.addEventListener('click', (e) => {
    const p = e.target.closest('.qp');
    if (!p || p.getAttribute('aria-disabled') === 'true') return;
    const k = p.dataset.change;
    activeChange = activeChange === k ? null : k;
    pillsEl.querySelectorAll('.qp').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.change === activeChange)));
    // Shareable: "#changed=stale" is a link to everything you have not revisited.
    history.replaceState(null, '', activeChange ? `#changed=${activeChange}` : location.pathname);
    apply();
  });

  // Both copies of the switch (toolbar on desktop, results line on a phone)
  // drive one piece of state, stored the way the theme is.
  function setDensity(d) {
    density = d === 'table' ? 'table' : 'cards';
    document.documentElement.setAttribute('data-density', density);
    try { localStorage.setItem('density', density); } catch (err) {}
    document.querySelectorAll('.dens .seg').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.density === density)));
    currentPage = 1;
    renderPage();
  }
  document.querySelectorAll('.dens .seg').forEach((b) => b.addEventListener('click', () => setDensity(b.dataset.density)));

  pagerEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.pg-btn');
    if (btn && !btn.disabled) goToPage(btn.dataset.pg);
  });

  listEl.addEventListener('click', (e) => {
    const nm = e.target.closest('.row-nm');
    if (nm) {
      const slug = nm.closest('.row').dataset.slug;
      history.replaceState(null, '', '#c-' + slug);
      flashRow(slug);
      if (navigator.clipboard) navigator.clipboard.writeText(location.href).then(() => toast('Link copied')).catch(() => {});
      return;
    }
    // Anywhere else on the card opens the company page. The explicit
    // "Full note →" link keeps this reachable without JS and by keyboard.
    if (e.target.closest('a')) return;
    const row = e.target.closest('.row');
    if (row && row.dataset.slug) location.href = `/company/${row.dataset.slug}/`;
  });
  tblHost.addEventListener('click', (e) => {
    if (e.target.closest('a')) return;
    const tr = e.target.closest('tr[data-slug]');
    if (tr) location.href = `/company/${tr.dataset.slug}/`;
  });
  listEl.addEventListener('keydown', (e) => {
    if ((e.key === 'Enter' || e.key === ' ') && e.target.closest('.row-nm')) { e.preventDefault(); e.target.closest('.row-nm').click(); }
  });

  exportBtn.addEventListener('click', () => {
    const symbols = lastVisible.filter((c) => c.tvCode).map((c) => `NSE:${c.tvCode}`);
    if (!symbols.length) { toast('No symbols to export'); return; }
    const blob = new Blob([symbols.join('\n')], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'watchlist.txt'; a.click();
    URL.revokeObjectURL(url);
  });

  // global keyboard: "/" focus search, Esc clears search
  document.addEventListener('keydown', (e) => {
    const tag = (document.activeElement.tagName || '').toLowerCase();
    if (e.key === '/' && tag !== 'input' && tag !== 'textarea' && tag !== 'select') { e.preventDefault(); searchEl.focus(); }
    else if (e.key === 'Escape' && document.activeElement === searchEl && searchEl.value) { searchEl.value = ''; apply(); }
  });

  // ---- custom dropdowns (native <select> kept in sync underneath) ----
  function enhanceSelect(sel) {
    const searchPlaceholder = sel.dataset.dd;
    const searchable = !!searchPlaceholder;
    const noteTpl = sel.dataset.note ? document.getElementById(sel.dataset.note) : null;
    const noteHTML = noteTpl ? noteTpl.innerHTML : '';
    // data-count renders a right-aligned tally in the menu only — the trigger
    // stays label-only so it doesn't read as "Q1 2027 · 15".
    const opts = [...sel.options].map((o) => ({ value: o.value, label: o.textContent, count: o.dataset.count || '' }));
    const labelOf = (v) => (opts.find((o) => o.value === v) || opts[0] || {}).label || '';

    const wrap = document.createElement('div');
    wrap.className = 'dd';
    sel.parentNode.insertBefore(wrap, sel);
    wrap.appendChild(sel);

    const btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'dd-trigger';
    btn.setAttribute('aria-haspopup', 'listbox'); btn.setAttribute('aria-expanded', 'false');
    const menu = document.createElement('div');
    menu.className = 'dd-menu'; menu.hidden = true;
    wrap.appendChild(btn); wrap.appendChild(menu);
    let activeIdx = -1;

    const CHEV = `<span class="dd-chev" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg></span>`;
    function paintTrigger() {
      const info = noteHTML ? `<span class="dd-info" tabindex="0" role="note" aria-label="What are tiers?">ⓘ<span class="dd-tip">${noteHTML}</span></span>` : '';
      btn.innerHTML = `<span class="dd-label">${esc(labelOf(sel.value))}</span>${info}${CHEV}`;
    }
    const optEls = () => [...menu.querySelectorAll('.dd-opt')];
    function highlight(i) {
      const os = optEls(); os.forEach((o) => o.classList.remove('kbd'));
      if (i >= 0 && i < os.length) { os[i].classList.add('kbd'); os[i].scrollIntoView({ block: 'nearest' }); activeIdx = i; }
    }
    function renderMenu(filter) {
      const f = (filter || '').toLowerCase();
      const list = opts.filter((o) => o.label.toLowerCase().includes(f));
      menu.innerHTML =
        (searchable ? `<div class="dd-search"><input type="text" placeholder="${esc(searchPlaceholder)}" /></div>` : '') +
        `<div class="dd-list" role="listbox">` +
        (list.length ? list.map((o) => `<button type="button" role="option" class="dd-opt${o.value === sel.value ? ' sel' : ''}" data-value="${esc(o.value)}">${esc(o.label)}${o.count ? `<span class="dd-n">${esc(o.count)}</span>` : ''}</button>`).join('') : `<div class="dd-empty">No matches</div>`) +
        `</div>`;
      activeIdx = optEls().findIndex((o) => o.classList.contains('sel'));
      if (searchable) {
        const si = menu.querySelector('.dd-search input');
        si.value = filter || '';
        si.addEventListener('input', () => renderMenu(si.value));
        setTimeout(() => si.focus(), 0);
      }
    }
    function open() { renderMenu(''); menu.hidden = false; wrap.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
    function close() { menu.hidden = true; wrap.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }

    btn.addEventListener('click', (e) => { if (e.target.closest('.dd-info')) { e.stopPropagation(); return; } e.stopPropagation(); menu.hidden ? open() : close(); });
    menu.addEventListener('click', (e) => {
      const opt = e.target.closest('.dd-opt');
      if (!opt) return;
      sel.value = opt.dataset.value;
      sel.dispatchEvent(new Event('change', { bubbles: true }));
      paintTrigger(); close(); btn.focus();
    });
    wrap.addEventListener('keydown', (e) => {
      if (menu.hidden) { if ((e.key === 'ArrowDown' || e.key === 'Enter') && document.activeElement === btn) { e.preventDefault(); open(); } return; }
      if (e.key === 'ArrowDown') { e.preventDefault(); highlight(Math.min(activeIdx + 1, optEls().length - 1)); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(Math.max(activeIdx - 1, 0)); }
      else if (e.key === 'Enter') { const o = optEls()[activeIdx]; if (o) { e.preventDefault(); o.click(); } }
    });
    // Repaint on any <select> change, including programmatic resets, so the
    // custom label never goes stale.
    sel.addEventListener('change', paintTrigger);
    paintTrigger();
    return { wrap, close, repaint: paintTrigger };
  }
  const dropdowns = [...document.querySelectorAll('select[data-dd]')].map(enhanceSelect);
  // One delegated pair of listeners for all dropdowns (was one pair per select):
  // any outside click, or Escape, closes every open menu.
  document.addEventListener('click', (e) => { dropdowns.forEach((d) => { if (!d.wrap.contains(e.target)) d.close(); }); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') dropdowns.forEach((d) => d.close()); });

  // Re-paginate if the viewport crosses the mobile/desktop breakpoint.
  mqMobile.addEventListener('change', () => { currentPage = 1; renderPage(); });

  // At 390px the descriptive placeholder truncates mid-word ("Search company nan").
  const syncPlaceholder = () => {
    searchEl.placeholder = mqMobile.matches ? 'Search company…' : 'Search company name or symbol…';
  };
  mqMobile.addEventListener('change', syncPlaceholder);
  syncPlaceholder();

  // Sync both switches to whatever was restored before paint.
  document.querySelectorAll('.dens .seg').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.density === density)));
  apply();
  handleHash();
  window.addEventListener('hashchange', handleHash);
</script>
