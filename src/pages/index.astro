---
import Base from '../layouts/Base.astro';
import data from '../data/companies.json';
import emas from '../data/emas.json';
import { VIEW_ORDER, VIEW_GLYPH, initialListHTML, viewCounts, quarterBuckets, newestQuarter, digestCounts, latestEntry, setupBand, commonAsOf, glossaryHTML } from '../lib/render.js';
import { BANDS } from '../lib/score.js';

// Attach the weekly-EMA record (10/20/40W + % distance) to each company by slug.
// Refreshed daily by .github/workflows/refresh-emas.yml; absent entries just
// render no panel.
const companies = data.companies.map((c) => ({ ...c, ema: (emas.companies || {})[c.slug] || null }));
const industries = [...new Set(companies.map((c) => c.industry).filter(Boolean))].sort();
const tiers = ['Tier 1', 'Tier 2', 'Tier 3', 'Tier 4'];
// Quarter options, newest first, each labelled with how many companies' CURRENT
// view comes from it. A company revisited later belongs to the newer bucket
// only, so these counts partition the book rather than overlapping.
const quarters = quarterBuckets(companies);

// The -fg variants, not -bar: these glyphs are 10px text on the page background, and
// the bar colours are tuned to be seen as a filled 8px block, not read as a shape
// (amber ◆ measured 2.06:1 on white). -bar still paints the distribution bar itself.
const viewDots = {
  Positive: 'var(--view-positive-fg)', Watch: 'var(--view-watch-fg)',
  Concern: 'var(--view-concern-fg)', Negative: 'var(--view-negative-fg)',
};
const VIEW_MEANING = {
  Positive: 'looks promising', Watch: 'keep an eye on',
  Concern: 'be cautious', Negative: 'avoid for now',
};

const counts = viewCounts(companies);
const newestQ = newestQuarter(companies);
// Band counts for the potential filter. Computed here so the select shows how many
// companies sit behind each option before you pick it, the way quarters do.
const SETUP_ORDER = Object.keys(BANDS);
const setupCounts = {};
for (const c of companies) {
  const e = latestEntry(c);
  const b = e ? setupBand(c, e) : null;
  const k = b || 'UNSCORED';
  setupCounts[k] = (setupCounts[k] || 0) + 1;
}
const setups = SETUP_ORDER.filter((b) => setupCounts[b])
  .map((b) => ({ value: b, label: BANDS[b].label, count: setupCounts[b] }));
// Every company lands in exactly one digest bucket, so the five counts partition
// the book and each can drive a filter.
const dg = digestCounts(companies);
const initialRows = initialListHTML(companies, 24);
// Stated once here instead of on all 24 cards; a company whose price is older than
// this still carries its own date. See commonAsOf() in render.js.
const priceAsOf = commonAsOf(companies);
// Same shape the EMA panel uses ("27 Aug '26"), so the one date on the page and the
// one on a stale card read as the same kind of thing.
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const asOfParts = priceAsOf ? /^(\d{4})-(\d{2})-(\d{2})/.exec(priceAsOf) : null;
const priceAsOfLabel = asOfParts
  ? `${+asOfParts[3]} ${MONTHS[+asOfParts[2] - 1]} '${asOfParts[1].slice(2)}`
  : null;
---
<Base title="Aadil Kadiwal · Equity Research & Views">
  <!-- Three gradings that look alike — a view, a tier and a score — named once, in the
       order the badges are printed. Dismissal is stored like the theme and read back
       before paint (Base.astro), so a returning reader never sees it. -->
  <section class="howto" id="howto" aria-labelledby="howto-h">
    <div class="howto-head">
      <p class="howto-h" id="howto-h">New here? Every card carries three badges</p>
      <button class="howto-x" id="howto-x" type="button" aria-label="Hide this introduction">✕</button>
    </div>
    <ol class="howto-items">
      <li>
        <span class="howto-eg"><span class="badge view-positive"><span class="gly">{VIEW_GLYPH.Positive}</span>Positive</span></span>
        <span class="howto-t"><b>The View</b> — my own call after reading the results and the earnings
          call.{' '}<i>Positive</i> looks promising, <i>Watch</i> keep an eye on, <i>Concern</i> be
          cautious,{' '}<i>Negative</i> avoid for now. A judgement, not a calculation.</span>
      </li>
      <li>
        <span class="howto-eg"><span class="badge tier">Tier 1</span></span>
        <span class="howto-t"><b>The Tier</b> — how fast the business is growing, graded 1 to 4 on the weaker
          of its yearly sales and profit growth. Tier 1 is both above 20%. Pure arithmetic.</span>
      </li>
      <li>
        <span class="howto-eg"><span class="mb-badge mb-strong">Strong<b class="mb-n">78<s>/100</s></b></span></span>
        <span class="howto-t"><b>Multibagger potential</b> — a 0–100 score of how strong the case looks
          on the{' '}<i>figures alone</i>: is it cheap, is it growing, has the market paid for that
          growth yet. A <b>multibagger</b> is a stock that returns several times what you paid.
          This score has not read the earnings call — the View has.</span>
      </li>
    </ol>
    <p class="howto-foot">
      <a class="howto-link" href="/how-to-read/">See a real card taken apart, piece by piece →</a>
      <span class="howto-note">Personal opinions, for information only — not investment advice.</span>
    </p>
  </section>
  <button class="howto-reopen" id="howto-reopen" type="button">ⓘ How to read this page</button>

  <!-- Title and legend share one line on desktop; stacked they cost 161px of
       every visit for information that fits in 52. -->
  <div class="topbar">
    <section class="hero">
      <h1 class="hero-title">Equity Research &amp; Views</h1>
    </section>

    <section class="view-summary" aria-label="View distribution across all companies">
      <div class="vs-bar">
        {VIEW_ORDER.filter((v) => counts[v] > 0).map((v) => (
          <span class={`vs-seg view-${v.toLowerCase()}`} style={`flex:${counts[v]}`} title={`${v}: ${counts[v]}`}></span>
        ))}
      </div>
      <!-- Buttons, not labels. These carry the same colour, glyph and count as the
           View chips inside the Filters panel, so reading them as filters and finding
           nothing happens was the obvious trap. Both drive one set of active views. -->
      <div class="vs-legend" id="vs-legend">
        {VIEW_ORDER.map((v) => (
          <button class="vs-item" data-view={v} aria-pressed="false" title={`Show only ${v}`}>
            <span class="gly" style={`color:${viewDots[v]}`}>{VIEW_GLYPH[v]}</span>
            <b>{v}</b> <span class="vs-meaning">{VIEW_MEANING[v]}</span> <span class="vs-n">{counts[v]}</span>
          </button>
        ))}
      </div>
      <!-- On a phone the meanings move behind the ⓘ and the counts stay: 85px → 22px. -->
      <div class="vs-compact" id="vs-compact">
        {VIEW_ORDER.map((v) => (
          <button class={`vsc view-${v.toLowerCase()}`} data-view={v} aria-pressed="false" title={`Show only ${v}`}><span class="gly">{VIEW_GLYPH[v]}</span>{counts[v]}</button>
        ))}
        <button class="vsc-i" id="vs-info" aria-expanded="false" aria-controls="vs-tip" aria-label="What the four views mean">i</button>
      </div>
      <div class="vs-tip" id="vs-tip" hidden>
        <p class="vs-tip-h">What the views mean</p>
        <ul>
          {VIEW_ORDER.map((v) => (
            <li><span class="gly" style={`color:${viewDots[v]}`}>{VIEW_GLYPH[v]}</span> <b>{v}</b> — {VIEW_MEANING[v]}</li>
          ))}
        </ul>
      </div>
    </section>
  </div>

  <!-- Counts only. Pressing a pill filters the list, which shows those companies
       as full cards or rows — better than a cramped column of names. A <details>
       could not do this: a <summary> swallows clicks on its own children. -->
  {(dg.up + dg.down + dg.new) > 0 && (
    <section class="digest" aria-label={`What changed in ${newestQ}`}>
      <div class="dg-bar">
        <span class="dg-title"><span class="dg-pre">What changed in </span><b>{newestQ}</b></span>
        <div class="dg-pills" id="dg-pills">
          {dg.up > 0 && <button class="qp up" data-change="up" aria-pressed="false"><span class="n">{dg.up}</span>↑ upgraded</button>}
          {dg.down > 0 && <button class="qp down" data-change="down" aria-pressed="false"><span class="n">{dg.down}</span>↓ downgraded</button>}
          {dg.new > 0 && <button class="qp new" data-change="new" aria-pressed="false"><span class="n">{dg.new}</span><span class="qp-lab">+ new<span class="qp-tail">ly covered</span></span></button>}
        </div>
      </div>
    </section>
  )}

  <!-- One toolbar at every width: a row that is always visible, and one panel
       behind Filters. Replaces the old two-row desktop toolbar. -->
  <div class="tbar-wrap">
    <div class="tbar">
      <input class="search" id="search" type="search" placeholder="Search company name or symbol…" autocomplete="off" />
      <button class="fbtn" id="fbtn" aria-expanded="false" aria-controls="tpanel">Filters<span class="fbtn-n" id="fbtn-n" hidden></span><span class="cv">▾</span></button>
      <span class="dens">
        <span class="segmented" role="tablist" aria-label="Density">
          <button class="seg" data-density="cards" aria-selected="true" aria-label="Card view" title="Card view"><span class="ic">▦</span><span class="lbl">Cards</span></button>
          <button class="seg" data-density="table" aria-selected="false" aria-label="Table view" title="Table view"><span class="ic">☰</span><span class="lbl">Table</span></button>
        </span>
      </span>
      <button class="btn ghost" id="export" title="Download the filtered list as a TradingView-importable NSE:SYMBOL text file">⬇ Watchlist<span class="wl-n" id="wl-n"></span></button>
    </div>

    <div class="tpanel" id="tpanel" hidden>
      <p class="tp-lab">Narrow by</p>
      <div class="tp-grid">
        <select id="industry" aria-label="Filter by industry" data-dd="Search industry…">
          <option value="">All industries</option>
          {industries.map((s) => <option value={s}>{s}</option>)}
        </select>
        <select id="quarter" aria-label="Filter by quarter" data-dd>
          <option value="" data-count={String(companies.length)}>All quarters</option>
          {quarters.map((q) => <option value={q.quarter} data-count={String(q.count)}>{q.quarter}</option>)}
        </select>
        <select id="tier" aria-label="Filter by tier" data-dd data-note="tier-note-tpl" data-note-label="What are tiers?">
          <option value="">All tiers</option>
          {tiers.map((t) => <option value={t}>{t}</option>)}
        </select>
        <select id="setup" aria-label="Filter by multibagger potential" data-dd data-note="setup-note-tpl" data-note-label="What is multibagger potential?">
          <option value="" data-count={String(companies.length)}>All potential</option>
          {setups.map((s2) => <option value={s2.value} data-count={String(s2.count)}>{s2.label}</option>)}
          {setupCounts.UNSCORED ? <option value="UNSCORED" data-count={String(setupCounts.UNSCORED)}>Not enough data</option> : null}
        </select>
      </div>
      <template id="setup-note-tpl">
        <div class="dd-note">
          <b>Multibagger potential</b> — a 0–100 score of how strong the case looks on the
          figures alone. A <b>multibagger</b> returns several times what you paid, which takes
          both growing earnings and buyers willing to pay more for them.
          <ul>
            <li><b>Strong</b> 75+ — a shortlist</li>
            <li><b>Good</b> 65–74 — a watchlist</li>
            <li><b>Average</b> 50–64 — the middle of the book</li>
            <li><b>Weak</b> 32–49 · <b>Poor</b> under 32</li>
            <li><b>Not enough data</b> — the growth figures for this quarter are not in yet</li>
          </ul>
          It has not read the earnings call. The View has.
        </div>
      </template>
      <template id="tier-note-tpl">
        <div class="dd-note">
          <b>Tier</b> = the weaker of YoY Sales &amp; PAT growth
          <ul>
            <li><b>Tier 1</b> — both ≥ 20%</li>
            <li><b>Tier 2</b> — both ≥ 15% (under 20)</li>
            <li><b>Tier 3</b> — both ≥ 10% (under 15)</li>
            <li><b>Tier 4</b> — either &lt; 10%</li>
          </ul>
        </div>
      </template>

      <div class="tp-two">
        <div>
          <p class="tp-lab">View</p>
          <div class="chips" id="view-chips">
            {VIEW_ORDER.map((v) => (
              <button class="chip" data-view={v} aria-pressed="false">
                <span class="gly" style={`color:${viewDots[v]}`}>{VIEW_GLYPH[v]}</span>{v}<span class="n" data-count></span>
              </button>
            ))}
          </div>
        </div>
        <div>
          <!-- The heading says what an EMA is; the ⓘ carries the rest. -->
          <p class="tp-lab">Price near its trend line <span class="tp-lab-sub">within 2%</span>
            <button class="lab-i" id="ema-info" type="button" aria-expanded="false" aria-controls="ema-tip" aria-label="What is a trend line?">ⓘ</button>
          </p>
          <div class="lab-tip" id="ema-tip" hidden>
            <p class="lab-tip-h">Trend lines</p>
            <p>A <b>trend line</b> is the average price over the last 10, 20 or 40 weeks —
              a smoothed version of the chart that ignores day-to-day noise. Its proper name is
              an <b>EMA</b>.</p>
            <p>A price sitting <b>right on</b> one of them is at a level buyers have defended before,
              which is why it is worth filtering for. <b>Bunched</b> means all three are within 5% of
              each other — the price has gone quiet, which often comes before it moves.</p>
          </div>
          <div class="ema-tools" id="ema-tools">
            <button class="chip" data-ema="near10" aria-pressed="false" title="Price within 2% of its 10-week trend line (10-week EMA)">10-week</button>
            <button class="chip" data-ema="near20" aria-pressed="false" title="Price within 2% of its 20-week trend line (20-week EMA)">20-week</button>
            <button class="chip" data-ema="near40" aria-pressed="false" title="Price within 2% of its 40-week trend line (40-week EMA)">40-week</button>
            <button class="chip" data-ema="converge" aria-pressed="false" title="All three trend lines bunched within 5% of each other — the price has gone quiet">⇉ All three bunched</button>
          </div>
        </div>
        <div class="tp-sort">
          <p class="tp-lab">Sort by</p>
          <select class="sort" id="sort" aria-label="Sort by" data-dd>
            <option value="view" selected>View · newest first</option>
            <option value="potential">Multibagger potential</option>
            <option value="upside">Upside · 3y</option>
            <option value="mcap">Market cap</option>
            <option value="name">Name A–Z</option>
            <option value="tier">Tier</option>
            <option value="quarter">Quarter</option>
            <option value="price">Price</option>
            <option value="d10">Distance from 10-week trend</option>
            <option value="d20">Distance from 20-week trend</option>
            <option value="d40">Distance from 40-week trend</option>
          </select>
        </div>
      </div>

      <div class="tp-foot">
        <button class="btn primary tp-show" id="tp-show" type="button">Show <b id="tp-show-n">0</b><span class="tp-show-tail"> companies</span></button>
        <button class="btn ghost tp-mob" id="export-m">⬇ Watchlist</button>
        <button class="token-reset" id="reset-panel">↺ Reset all</button>
      </div>
    </div>
  </div>

  <div class="active-filters" id="active-filters"></div>
  <!-- Text only. The density switch went back into the toolbar as two icons, which
       turns this from a 41px band on a phone into one 18px line. -->
  <div class="count-row">
    <p class="count" id="count" role="status" aria-live="polite"></p>
    {priceAsOfLabel && <span class="asof" title={`Prices and EMAs as of ${priceAsOfLabel}`}>Prices {priceAsOfLabel}</span>}
  </div>

  <h2 class="sr-only">Companies</h2>
  <div class="list" id="list" set:html={initialRows}></div>
  <div id="tblhost"></div>
  <div class="empty-state" id="empty" style="display:none">
    No companies match your filters. <button class="btn ghost" id="clear-empty">↺ Reset</button>
  </div>
  <nav class="pager" id="pager" aria-label="Pagination"></nav>

  <section class="panel gloss-panel gloss-list" set:html={glossaryHTML()}></section>

  <script type="application/json" id="dataset" set:html={JSON.stringify(companies).replace(/</g, '\\u003c')}></script>
</Base>

<script>
  import { rowHTML, tableRowHTML, tableHTML, compactRowHTML, compactListHTML, latestEntry, newestQuarter, changeClass, VIEW_GLYPH, viewRank, esc, setupBand, setupOutlook, setupRank, redundantFields } from '../lib/render.js';
  import { quarterKey } from '../lib/format.js';
  import { initTapTips } from '../lib/taptip.js';

  const DATA = JSON.parse(document.getElementById('dataset').textContent);
  const NEWEST_Q = newestQuarter(DATA);

  const listEl = document.getElementById('list');
  const searchEl = document.getElementById('search');
  const sortEl = document.getElementById('sort');
  const quarterEl = document.getElementById('quarter');
  const tierEl = document.getElementById('tier');
  const industryEl = document.getElementById('industry');
  const countEl = document.getElementById('count');
  const emptyEl = document.getElementById('empty');
  const chipsEl = document.getElementById('view-chips');
  const exportBtn = document.getElementById('export');
  const activeFiltersEl = document.getElementById('active-filters');
  const setupEl = document.getElementById('setup');
  // Labels for the active-filter chip; the option text already carries them, but the
  // chip is built in script.
  const BAND_LABEL = { STRONG: 'Strong', FAIR: 'Good', THIN: 'Average',
    WEAK: 'Weak', NONE: 'Poor' };
  const pagerEl = document.getElementById('pager');
  const tblHost = document.getElementById('tblhost');
  // Absent when no bucket has anything in it, so every use is guarded.
  const pillsEl = document.getElementById('dg-pills');
  const fbtn = document.getElementById('fbtn');
  const fbtnN = document.getElementById('fbtn-n');
  const tpanel = document.getElementById('tpanel');
  const wlN = document.getElementById('wl-n');
  const showBtn = document.getElementById('tp-show');
  const showN = document.getElementById('tp-show-n');

  const emaToolsEl = document.getElementById('ema-tools');
  const vsLegendEl = document.getElementById('vs-legend');
  const vsCompactEl = document.getElementById('vs-compact');
  const activeViews = new Set();
  const activeEma = new Set();
  // Which digest bucket is filtering, if any. Single-select: the five buckets
  // partition the book, so combining them would always give an empty set.
  let activeChange = null;
  // Cards are tall, so phones get half as many. Table rows are the same height
  // everywhere, so 50 holds at both widths.
  const mqMobile = window.matchMedia('(max-width: 640px)');
  let density = document.documentElement.getAttribute('data-density') === 'table' ? 'table' : 'cards';
  const pageSize = () => (density === 'table' ? 50 : (mqMobile.matches ? 12 : 24));
  let PAGE_SIZE = pageSize();
  let currentPage = 1;
  let lastVisible = [];
  // The default must stay view/asc — that is the order initialListHTML() renders
  // at build time, so anything else reflows the SSR'd first page on load.
  const SORT_DIR = {
    view: 'asc', name: 'asc', tier: 'asc',
    mcap: 'desc', quarter: 'desc', price: 'desc', d10: 'desc', d20: 'desc', d40: 'desc',
    potential: 'desc', upside: 'desc',
  };
  let sortKey = 'view';
  let sortDir = 'asc';

  // Rank by the tier shown on the card (latest quarter), not the company-level
  // field, so the sort order matches what's rendered.
  const tierRank = (c) => { const m = /(\d)/.exec((c._latest && c._latest.tier) || c.tier || ''); return m ? +m[1] : 9; };

  // Search matches company name and symbol (tvCode) only — not industry or
  // notes. Use the industry/tier dropdowns to narrow by those.
  const haystack = (c) => {
    if (c._haystack == null) {
      c._haystack = `${c.name} ${c.tvCode || ''}`.toLowerCase();
    }
    return c._haystack;
  };
  function matches(c, term) {
    return haystack(c).includes(term);
  }

  function apply() {
    const term = searchEl.value.trim().toLowerCase();
    const quarter = quarterEl.value;
    const tier = tierEl.value;
    const industry = industryEl.value;

    // Resolve each company's latest quarter once per pass and cache it on the
    // object — filter, counts, view-filter and the sort comparators all reuse it
    // instead of re-reducing the timeline every time.
    const setup = setupEl ? setupEl.value : '';
    const base = DATA.filter((c) => {
      c._latest = latestEntry(c);
      if (!c._latest) return false;
      // Quarter = where a company's CURRENT view comes from, so the buckets
      // partition the book: one revisited later drops out of the older bucket.
      if (quarter && c._latest.quarter !== quarter) return false;
      if (term && !matches(c, term)) return false;
      // Match the tier shown on the card (latest quarter), not the company field.
      if (tier && (c._latest.tier || c.tier) !== tier) return false;
      if (industry && c.industry !== industry) return false;
      if (activeChange && changeClass(c, NEWEST_Q) !== activeChange) return false;
      // "NONE" is the blank bucket: companies with no band at all, which is how you
      // find the ones still missing growth or price data.
      if (setup) {
        const b = setupBand(c, c._latest);
        if (setup === 'UNSCORED' ? b !== null : b !== setup) return false;
      }
      return true;
    });

    const counts = { Positive: 0, Watch: 0, Concern: 0, Negative: 0 };
    base.forEach((c) => { const v = c._latest.view; if (counts[v] != null) counts[v]++; });
    chipsEl.querySelectorAll('.chip').forEach((chip) => {
      chip.querySelector('[data-count]').textContent = ' ' + (counts[chip.dataset.view] ?? 0);
    });

    let visible = base.filter((c) => activeViews.size === 0 || activeViews.has(c._latest.view));

    // EMA screening: keep only companies matching every active "vs EMA" chip.
    // "Near" = price within NEAR% of that weekly EMA. "Converging" = the three
    // EMAs are bunched within CONVERGE% of each other (a weekly squeeze).
    if (activeEma.size) {
      const NEAR = 2, CONVERGE = 5;
      const near = (r, w) => { const v = r.dist && r.dist[w]; return v != null && Math.abs(v) <= NEAR; };
      visible = visible.filter((c) => {
        const r = c.ema;
        if (!r) return false;
        if (activeEma.has('near10') && !near(r, '10W')) return false;
        if (activeEma.has('near20') && !near(r, '20W')) return false;
        if (activeEma.has('near40') && !near(r, '40W')) return false;
        if (activeEma.has('converge') && !(r.spread != null && r.spread <= CONVERGE)) return false;
        return true;
      });
    }

    visible.sort(comparator());

    lastVisible = visible;
    currentPage = 1;
    renderPage();
    renderActiveFilters(term, quarter, tier, industry);
    writeURL(term, quarter, tier, industry);
  }

  // A missing value sorts last in BOTH directions, so nulls never lead the list.
  const NUM_KEY = {
    mcap: (c) => c.marketCap,
    quarter: (c) => quarterKey(c._latest.quarter),
    price: (c) => (c.ema ? c.ema.price : null),
    d10: (c) => (c.ema && c.ema.dist ? c.ema.dist['10W'] : null),
    d20: (c) => (c.ema && c.ema.dist ? c.ema.dist['20W'] : null),
    d40: (c) => (c.ema && c.ema.dist ? c.ema.dist['40W'] : null),
    // Score first, outlook only as a tiebreak — so the order always matches the
    // number every row prints. Sorting on the projection alone put a flagged
    // Moderate company above a clean Strong one under a "case strength" label.
    // Companies with nothing to project return null and sort last, as nulls do.
    potential: (c) => setupRank(c, c._latest),
    // The projection on its own, for when the SIZE of the prize is the question
    // being asked. Labelled as what it is, so it cannot be mistaken for the case.
    upside: (c) => setupOutlook(c, c._latest),
  };

  function comparator() {
    const s = sortDir === 'asc' ? 1 : -1;
    const byCap = (a, b) => (b.marketCap || 0) - (a.marketCap || 0);
    // Newest quarter first, so within each view band the freshest thinking
    // surfaces above views that haven't been revisited.
    const byQuarter = (a, b) => quarterKey(b._latest.quarter) - quarterKey(a._latest.quarter);
    if (sortKey === 'name') return (a, b) => s * a.name.localeCompare(b.name);
    if (sortKey === 'tier') return (a, b) => s * (tierRank(a) - tierRank(b)) || byCap(a, b);
    // Keep the view branch in lockstep with initialListHTML() in render.js — a
    // mismatch reorders the SSR'd first page the moment this script runs.
    if (sortKey === 'view') {
      return (a, b) => s * (viewRank(a._latest.view) - viewRank(b._latest.view)) || byQuarter(a, b) || byCap(a, b);
    }
    const val = NUM_KEY[sortKey] || NUM_KEY.mcap;
    return (a, b) => {
      const x = val(a), y = val(b);
      if (x == null && y == null) return byCap(a, b);
      if (x == null) return 1;
      if (y == null) return -1;
      return s * (x - y) || byCap(a, b);
    };
  }

  function setSort(key, dir) {
    sortKey = SORT_DIR[key] ? key : 'view';
    sortDir = dir || SORT_DIR[sortKey];
    if (sortEl.value !== sortKey) { sortEl.value = sortKey; dropdowns.forEach((d) => d.repaint()); }
  }

  // Only non-default values are written, so an untouched list keeps a clean URL.
  let restoring = false;
  function writeURL(term, quarter, tier, industry) {
    if (restoring) return;
    const p = new URLSearchParams();
    if (term) p.set('q', term);
    if (activeViews.size) p.set('view', [...activeViews].join(','));
    if (tier) p.set('tier', tier.replace(/^Tier\s*/i, ''));
    if (industry) p.set('industry', industry);
    if (quarter) p.set('quarter', quarter);
    if (activeEma.size) p.set('ema', [...activeEma].join(','));
    if (activeChange) p.set('changed', activeChange);
    if (setupEl && setupEl.value) p.set('setup', setupEl.value);
    if (sortKey !== 'view') p.set('sort', sortKey);
    if (sortDir !== SORT_DIR[sortKey]) p.set('dir', sortDir);
    const qs = p.toString();
    // A #c-slug anchor is a deep link and has to survive; the old #changed= hash
    // does not, because `changed` is a query param now.
    const hash = /^#changed=/.test(location.hash) ? '' : location.hash;
    history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + hash);
  }

  function readURL() {
    const p = new URLSearchParams(location.search);
    const legacy = /^#changed=(up|down|new)$/.exec(location.hash);
    if (![...p.keys()].length && !legacy) return false;
    restoring = true;
    searchEl.value = p.get('q') || '';
    const t = p.get('tier');
    tierEl.value = t ? (/^\d$/.test(t) ? `Tier ${t}` : t) : '';
    industryEl.value = p.get('industry') || '';
    quarterEl.value = p.get('quarter') || '';
    if (setupEl) setupEl.value = p.get('setup') || '';
    (p.get('view') || '').split(',').filter(Boolean).forEach((v) => {
      if (chipsEl.querySelector(`.chip[data-view="${CSS.escape(v)}"]`)) activeViews.add(v);
    });
    paintViews();
    (p.get('ema') || '').split(',').filter(Boolean).forEach((k) => {
      const chip = emaToolsEl.querySelector(`.chip[data-ema="${CSS.escape(k)}"]`);
      if (chip) { activeEma.add(k); chip.setAttribute('aria-pressed', 'true'); }
    });
    const ch = p.get('changed') || (legacy ? legacy[1] : null);
    if (ch && pillsEl && pillsEl.querySelector(`.qp[data-change="${ch}"]`)) {
      activeChange = ch;
      pillsEl.querySelectorAll('.qp').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.change === ch)));
    }
    setSort(p.get('sort') || 'view', p.get('dir') === 'asc' || p.get('dir') === 'desc' ? p.get('dir') : null);
    restoring = false;
    return true;
  }

  const CHANGE_LABEL = { up: 'upgraded', down: 'downgraded', new: 'newly covered' };

  function renderPage() {
    const total = lastVisible.length;
    PAGE_SIZE = pageSize();
    const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
    if (currentPage > pages) currentPage = pages;
    const start = (currentPage - 1) * PAGE_SIZE;
    const slice = lastVisible.slice(start, start + PAGE_SIZE);
    const entry = (c) => c._latest || latestEntry(c);
    // Over the whole filtered set, not the page: which badge or column is dropped
    // must not change as you page through the same result set.
    const redundant = redundantFields(lastVisible);
    if (density === 'table') {
      tblHost.innerHTML = mqMobile.matches
        ? compactListHTML(slice.map((c) => compactRowHTML(c, entry(c), redundant)).join(''))
        : tableHTML(slice.map((c) => tableRowHTML(c, entry(c))).join(''), { key: sortKey, dir: sortDir }, redundant);
      listEl.innerHTML = '';
    } else {
      listEl.innerHTML = slice.map((c) => rowHTML(c, entry(c), redundant)).join('');
      tblHost.innerHTML = '';
    }
    emptyEl.style.display = total === 0 ? '' : 'none';
    // The bucket name lands here rather than in the pill, where it would be long.
    const suffix = activeChange ? ` · ${CHANGE_LABEL[activeChange]}` : '';
    countEl.innerHTML = total === 0
      ? '0 companies'
      : `Showing <b>${start + 1}–${start + slice.length}</b> of <b>${total}</b>${suffix}`;
    if (wlN) wlN.textContent = total ? ` (${total})` : '';
    if (showN) showN.textContent = String(total);
    // With nothing narrowed, "Show 127 companies" is a primary-styled no-op — the
    // list below already shows all 127. It only becomes an action once a filter bites.
    if (showBtn) {
      const narrowed = total !== DATA.length;
      showBtn.classList.toggle('is-noop', !narrowed);
      showBtn.firstChild.textContent = narrowed ? 'Show ' : 'Done';
      showN.hidden = !narrowed;
      const tail = showBtn.querySelector('.tp-show-tail');
      if (tail) tail.hidden = !narrowed;
    }
    renderPagination(pages);
  }

  function pageWindow(cur, pages) {
    const out = [];
    for (let i = 1; i <= pages; i++) {
      if (i === 1 || i === pages || (i >= cur - 1 && i <= cur + 1)) out.push(i);
      else if (out[out.length - 1] !== '…') out.push('…');
    }
    return out;
  }

  function renderPagination(pages) {
    if (pages <= 1) { pagerEl.innerHTML = ''; return; }
    let html = `<button class="pg-btn" data-pg="prev" ${currentPage === 1 ? 'disabled' : ''}>‹ Prev</button>`;
    for (const p of pageWindow(currentPage, pages)) {
      html += p === '…' ? `<span class="pg-gap">…</span>` : `<button class="pg-btn pg-num${p === currentPage ? ' active' : ''}" data-pg="${p}">${p}</button>`;
    }
    html += `<button class="pg-btn" data-pg="next" ${currentPage === pages ? 'disabled' : ''}>Next ›</button>`;
    html += `<span class="pg-size">${PAGE_SIZE} per page</span>`;
    pagerEl.innerHTML = html;
  }

  function goToPage(p) {
    const pages = Math.max(1, Math.ceil(lastVisible.length / PAGE_SIZE));
    if (p === 'prev') p = currentPage - 1; else if (p === 'next') p = currentPage + 1; else p = parseInt(p, 10);
    currentPage = Math.min(Math.max(1, p), pages);
    renderPage();
    document.querySelector('.tbar-wrap').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function renderActiveFilters(term, quarter, tier, industry) {
    const setupVal = setupEl ? setupEl.value : '';
    const setupLabel = setupVal === 'UNSCORED' ? 'Not enough data'
      : setupVal ? BAND_LABEL[setupVal] : '';
    // Faceted chips: each carries its category (kicker or, for views, a coloured
    // glyph) so you can read WHAT is filtered at a glance, not just the value.
    const tokens = [];
    if (term) tokens.push({ type: 'search', cat: 'Search', label: term });
    if (quarter) tokens.push({ type: 'quarter', cat: 'Quarter', label: quarter });
    [...activeViews].forEach((v) => tokens.push({ type: 'view', val: v, label: v, cls: `view-${v.toLowerCase()}`, gly: VIEW_GLYPH[v] }));
    if (tier) tokens.push({ type: 'tier', cat: 'Tier', label: tier.replace(/^Tier\s*/i, '') });
    if (industry) tokens.push({ type: 'industry', cat: 'Industry', label: industry });
    if (setupVal) tokens.push({ type: 'setup', val: setupVal, cat: 'Potential', label: setupLabel });
    if (activeChange) tokens.push({ type: 'change', val: activeChange, cat: 'Changed', label: CHANGE_LABEL[activeChange] });
    const emaShort = { near10: 'Near 10-week', near20: 'Near 20-week', near40: 'Near 40-week', converge: 'All three bunched' };
    [...activeEma].forEach((k) => tokens.push({ type: 'ema', val: k, cat: 'Trend', label: emaShort[k] }));
    // "Dirty" = any filter OR a non-default sort — so Reset also surfaces when
    // only the sort was changed (Reset returns sort to View too).
    const sorted = sortKey !== 'view' || sortDir !== SORT_DIR.view;
    const dirty = tokens.length || sorted;
    // The button carries a count so a collapsed panel never hides that filters
    // are on. Search and the digest bucket live outside the panel, so they don't.
    const inPanel = tokens.filter((t) => t.type !== 'search' && t.type !== 'change').length
      + (sorted ? 1 : 0);
    fbtnN.hidden = inPanel === 0;
    fbtnN.textContent = String(inPanel);
    if (!dirty) { activeFiltersEl.innerHTML = ''; return; }
    const chip = (t) => {
      const lead = t.gly ? `<span class="tk-gly">${t.gly}</span>`
        : (t.cat ? `<span class="tk-cat">${esc(t.cat)}</span>` : '');
      return `<button class="token token-${t.type}${t.cls ? ' ' + t.cls : ''}" data-type="${t.type}" data-val="${esc(t.val || '')}" title="Remove this filter">`
        + `${lead}<span class="tk-val">${esc(t.label)}</span><span class="x" aria-hidden="true">✕</span></button>`;
    };
    activeFiltersEl.innerHTML =
      `<span class="af-lead">Filters</span>` +
      tokens.map(chip).join('') +
      `<button class="token-reset" id="reset" title="Reset all filters and sort to default">↺ Reset</button>`;
  }

  // Blank every control WITHOUT applying — popstate re-reads the URL right after,
  // so this stops stale chips from surviving a Back.
  function clearControls() {
    searchEl.value = ''; quarterEl.value = ''; tierEl.value = ''; industryEl.value = '';
    activeViews.clear(); activeEma.clear(); activeChange = null;
    sortKey = 'view'; sortDir = SORT_DIR.view; sortEl.value = 'view';
    if (pillsEl) pillsEl.querySelectorAll('.qp').forEach((b) => b.setAttribute('aria-pressed', 'false'));
    paintViews();
    emaToolsEl.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
    dropdowns.forEach((d) => d.repaint());
  }

  function clearAll() {
    searchEl.value = ''; quarterEl.value = ''; tierEl.value = ''; industryEl.value = '';
    if (setupEl) setupEl.value = '';
    sortKey = 'view'; sortDir = SORT_DIR.view; sortEl.value = 'view';
    activeViews.clear();
    activeEma.clear();
    activeChange = null;
    if (pillsEl) pillsEl.querySelectorAll('.qp').forEach((p) => p.setAttribute('aria-pressed', 'false'));
    paintViews();
    emaToolsEl.querySelectorAll('.chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
    dropdowns.forEach((d) => d.repaint());   // resync custom-dropdown labels to the reset <select>s
    apply();
  }

  // ---- toast + deep-link anchors ----
  let toastEl;
  function toast(msg) {
    if (!toastEl) { toastEl = document.createElement('div'); toastEl.className = 'toast'; document.body.appendChild(toastEl); }
    toastEl.textContent = msg; toastEl.classList.add('show');
    clearTimeout(toast._t); toast._t = setTimeout(() => toastEl.classList.remove('show'), 1500);
  }
  function flashRow(slug) {
    const el = document.getElementById('c-' + slug);
    if (!el) return false;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.classList.add('row-flash');
    setTimeout(() => el.classList.remove('row-flash'), 1600);
    return true;
  }
  function handleHash() {
    // Legacy #changed= links are handled by readURL(), which rewrites them as
    // ?changed= — so only company anchors are left here.
    if (/^#changed=/.test(location.hash)) { readURL(); apply(); return; }
    const m = /^#c-(.+)$/.exec(location.hash);
    if (!m) return;
    const slug = decodeURIComponent(m[1]);
    if (!DATA.some((c) => c.slug === slug)) return;
    // make sure it's on the current filtered set + right page
    if (!lastVisible.some((c) => c.slug === slug)) clearAll();
    const idx = lastVisible.findIndex((c) => c.slug === slug);
    if (idx >= 0) { currentPage = Math.floor(idx / PAGE_SIZE) + 1; renderPage(); }
    setTimeout(() => flashRow(slug), 60);
  }

  // events
  // Debounce search so each keystroke doesn't trigger a full filter+sort+rebuild.
  let searchDebounce;
  searchEl.addEventListener('input', () => { clearTimeout(searchDebounce); searchDebounce = setTimeout(apply, 140); });
  sortEl.addEventListener('change', () => { setSort(sortEl.value); apply(); });
  quarterEl.addEventListener('change', apply);
  tierEl.addEventListener('change', apply);
  industryEl.addEventListener('change', apply);
  if (setupEl) setupEl.addEventListener('change', apply);

  // The panel chips, the legend and the phone's count pills are three views of one
  // set. Painting them from the set (rather than from the element clicked) is what
  // keeps them from drifting apart.
  function paintViews() {
    document.querySelectorAll('[data-view]').forEach((el) => {
      el.setAttribute('aria-pressed', String(activeViews.has(el.dataset.view)));
    });
  }
  function toggleView(v) {
    if (!v) return;
    if (activeViews.has(v)) activeViews.delete(v); else activeViews.add(v);
    paintViews();
    apply();
  }
  [chipsEl, vsLegendEl, vsCompactEl].forEach((host) => {
    if (host) host.addEventListener('click', (e) => {
      const el = e.target.closest('[data-view]');
      if (el && host.contains(el)) toggleView(el.dataset.view);
    });
  });

  emaToolsEl.addEventListener('click', (e) => {
    const chip = e.target.closest('.chip');
    if (!chip) return;
    const k = chip.dataset.ema;
    if (activeEma.has(k)) { activeEma.delete(k); chip.setAttribute('aria-pressed', 'false'); }
    else { activeEma.add(k); chip.setAttribute('aria-pressed', 'true'); }
    apply();
  });

  activeFiltersEl.addEventListener('click', (e) => {
    if (e.target.closest('#reset')) return clearAll();
    const tok = e.target.closest('.token');
    if (!tok) return;
    const { type, val } = tok.dataset;
    if (type === 'search') searchEl.value = '';
    else if (type === 'quarter') { quarterEl.value = ''; quarterEl.dispatchEvent(new Event('change', { bubbles: true })); }
    else if (type === 'tier') { tierEl.value = ''; tierEl.dispatchEvent(new Event('change', { bubbles: true })); }
    else if (type === 'industry') { industryEl.value = ''; industryEl.dispatchEvent(new Event('change', { bubbles: true })); }
    else if (type === 'view') { activeViews.delete(val); paintViews(); }
    else if (type === 'ema') { activeEma.delete(val); emaToolsEl.querySelector(`.chip[data-ema="${val}"]`)?.setAttribute('aria-pressed', 'false'); }
    else if (type === 'setup') { if (setupEl) { setupEl.value = ''; setupEl.dispatchEvent(new Event('change', { bubbles: true })); } }
    else if (type === 'change') { activeChange = null; if (pillsEl) pillsEl.querySelectorAll('.qp').forEach((p) => p.setAttribute('aria-pressed', 'false')); }
    apply();
  });

  document.getElementById('clear-empty').addEventListener('click', clearAll);
  document.getElementById('reset-panel').addEventListener('click', clearAll);
  document.getElementById('export-m').addEventListener('click', () => exportBtn.click());

  function setPanel(open) {
    tpanel.toggleAttribute('hidden', !open);
    fbtn.setAttribute('aria-expanded', String(open));
  }
  fbtn.addEventListener('click', () => setPanel(tpanel.hasAttribute('hidden')));
  showBtn.addEventListener('click', () => { setPanel(false); fbtn.focus(); });

  if (pillsEl) pillsEl.addEventListener('click', (e) => {
    const p = e.target.closest('.qp');
    if (!p) return;
    const k = p.dataset.change;
    activeChange = activeChange === k ? null : k;
    pillsEl.querySelectorAll('.qp').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.change === activeChange)));
    apply();
  });

  // Both copies of the switch (toolbar on desktop, results line on a phone)
  // drive one piece of state, stored the way the theme is.
  function setDensity(d) {
    density = d === 'table' ? 'table' : 'cards';
    document.documentElement.setAttribute('data-density', density);
    try { localStorage.setItem('density', density); } catch (err) {}
    document.querySelectorAll('.dens .seg').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.density === density)));
    currentPage = 1;
    renderPage();
  }
  document.querySelectorAll('.dens .seg').forEach((b) => b.addEventListener('click', () => setDensity(b.dataset.density)));

  pagerEl.addEventListener('click', (e) => {
    const btn = e.target.closest('.pg-btn');
    if (btn && !btn.disabled) goToPage(btn.dataset.pg);
  });

  function copyLink(slug) {
    const url = location.origin + location.pathname + '#c-' + slug;
    if (navigator.clipboard) navigator.clipboard.writeText(url).then(() => toast('Link copied')).catch(() => {});
    else toast('Copy not supported');
  }

  listEl.addEventListener('click', (e) => {
    const copy = e.target.closest('.row-copy');
    if (copy) { e.preventDefault(); copyLink(copy.dataset.copy); return; }
    // Anywhere else on the card opens the company page; the name and
    // "Full note →" are real links, so that path also works without JS.
    if (e.target.closest('a')) return;
    const row = e.target.closest('.row');
    if (row && row.dataset.slug) location.href = `/company/${row.dataset.slug}/`;
  });
  tblHost.addEventListener('click', (e) => {
    if (e.target.closest('a') || e.target.closest('.th-btn')) return;
    const line = e.target.closest('tr[data-slug], .crow[data-slug]');
    if (line) location.href = `/company/${line.dataset.slug}/`;
  });

  tblHost.addEventListener('click', (e) => {
    const th = e.target.closest('th[data-sort]');
    if (!th) return;
    const key = th.dataset.sort;
    const fromKeyboard = document.activeElement && document.activeElement.closest('th[data-sort]');
    setSort(key, key === sortKey ? (sortDir === 'asc' ? 'desc' : 'asc') : null);
    apply();
    // The header row is re-rendered, so focus has to be put back by hand.
    if (fromKeyboard) tblHost.querySelector(`th[data-sort="${key}"] .th-btn`)?.focus();
  });

  exportBtn.addEventListener('click', () => {
    const symbols = lastVisible.filter((c) => c.tvCode).map((c) => `NSE:${c.tvCode}`);
    if (!symbols.length) { toast('No symbols to export'); return; }
    const blob = new Blob([symbols.join('\n')], { type: 'text/plain' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = 'watchlist.txt'; a.click();
    URL.revokeObjectURL(url);
  });

  // global keyboard: "/" focus search, Esc clears search
  document.addEventListener('keydown', (e) => {
    const tag = (document.activeElement.tagName || '').toLowerCase();
    if (e.key === '/' && tag !== 'input' && tag !== 'textarea' && tag !== 'select') { e.preventDefault(); searchEl.focus(); }
    else if (e.key === 'Escape' && document.activeElement === searchEl && searchEl.value) { searchEl.value = ''; apply(); }
  });

  // ---- custom dropdowns (native <select> kept in sync underneath) ----
  function enhanceSelect(sel) {
    const searchPlaceholder = sel.dataset.dd;
    const searchable = !!searchPlaceholder;
    const noteTpl = sel.dataset.note ? document.getElementById(sel.dataset.note) : null;
    const noteHTML = noteTpl ? noteTpl.innerHTML : '';
    const noteLabel = sel.dataset.noteLabel || 'More about this filter';
    // data-count renders a right-aligned tally in the menu only — the trigger
    // stays label-only so it doesn't read as "Q1 2027 · 15".
    const opts = [...sel.options].map((o) => ({ value: o.value, label: o.textContent, count: o.dataset.count || '' }));
    const labelOf = (v) => (opts.find((o) => o.value === v) || opts[0] || {}).label || '';

    const wrap = document.createElement('div');
    wrap.className = 'dd';
    sel.parentNode.insertBefore(wrap, sel);
    wrap.appendChild(sel);

    const btn = document.createElement('button');
    btn.type = 'button'; btn.className = 'dd-trigger';
    btn.setAttribute('aria-haspopup', 'listbox'); btn.setAttribute('aria-expanded', 'false');
    const menu = document.createElement('div');
    menu.className = 'dd-menu'; menu.hidden = true;
    wrap.appendChild(btn); wrap.appendChild(menu);
    let activeIdx = -1;

    const CHEV = `<span class="dd-chev" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg></span>`;
    function paintTrigger() {
      const info = noteHTML ? `<span class="dd-info" tabindex="0" role="note" aria-label="${esc(noteLabel)}">ⓘ<span class="dd-tip">${noteHTML}</span></span>` : '';
      btn.innerHTML = `<span class="dd-label">${esc(labelOf(sel.value))}</span>${info}${CHEV}`;
    }
    const optEls = () => [...menu.querySelectorAll('.dd-opt')];
    function highlight(i) {
      const os = optEls(); os.forEach((o) => o.classList.remove('kbd'));
      if (i >= 0 && i < os.length) { os[i].classList.add('kbd'); os[i].scrollIntoView({ block: 'nearest' }); activeIdx = i; }
    }
    function renderMenu(filter) {
      const f = (filter || '').toLowerCase();
      const list = opts.filter((o) => o.label.toLowerCase().includes(f));
      menu.innerHTML =
        (searchable ? `<div class="dd-search"><input type="text" placeholder="${esc(searchPlaceholder)}" /></div>` : '') +
        `<div class="dd-list" role="listbox">` +
        (list.length ? list.map((o) => `<button type="button" role="option" class="dd-opt${o.value === sel.value ? ' sel' : ''}" data-value="${esc(o.value)}">${esc(o.label)}${o.count ? `<span class="dd-n">${esc(o.count)}</span>` : ''}</button>`).join('') : `<div class="dd-empty">No matches</div>`) +
        `</div>`;
      activeIdx = optEls().findIndex((o) => o.classList.contains('sel'));
      if (searchable) {
        const si = menu.querySelector('.dd-search input');
        si.value = filter || '';
        si.addEventListener('input', () => renderMenu(si.value));
        setTimeout(() => si.focus(), 0);
      }
    }
    function open() { renderMenu(''); menu.hidden = false; wrap.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
    function close() { menu.hidden = true; wrap.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }

    btn.addEventListener('click', (e) => { if (e.target.closest('.dd-info')) { e.stopPropagation(); return; } e.stopPropagation(); menu.hidden ? open() : close(); });
    menu.addEventListener('click', (e) => {
      const opt = e.target.closest('.dd-opt');
      if (!opt) return;
      sel.value = opt.dataset.value;
      sel.dispatchEvent(new Event('change', { bubbles: true }));
      paintTrigger(); close(); btn.focus();
    });
    wrap.addEventListener('keydown', (e) => {
      if (menu.hidden) { if ((e.key === 'ArrowDown' || e.key === 'Enter') && document.activeElement === btn) { e.preventDefault(); open(); } return; }
      if (e.key === 'ArrowDown') { e.preventDefault(); highlight(Math.min(activeIdx + 1, optEls().length - 1)); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(Math.max(activeIdx - 1, 0)); }
      else if (e.key === 'Enter') { const o = optEls()[activeIdx]; if (o) { e.preventDefault(); o.click(); } }
    });
    // Repaint on any <select> change, including programmatic resets, so the
    // custom label never goes stale.
    sel.addEventListener('change', paintTrigger);
    paintTrigger();
    return { wrap, close, repaint: paintTrigger };
  }
  const dropdowns = [...document.querySelectorAll('select[data-dd]')].map(enhanceSelect);
  // One delegated pair of listeners for all dropdowns (was one pair per select):
  // any outside click, or Escape, closes every open menu.
  document.addEventListener('click', (e) => { dropdowns.forEach((d) => { if (!d.wrap.contains(e.target)) d.close(); }); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') dropdowns.forEach((d) => d.close()); });

  // Re-paginate if the viewport crosses the mobile/desktop breakpoint — in table
  // density this also swaps the table for compact rows and back.
  mqMobile.addEventListener('change', () => { currentPage = 1; renderPage(); });

  // The legend's ⓘ needs a real popover: a title= tooltip never shows on touch,
  // and the compact legend is the phone layout.
  const vsInfo = document.getElementById('vs-info');
  const vsTip = document.getElementById('vs-tip');
  function closeVsTip() { vsTip.hidden = true; vsInfo.setAttribute('aria-expanded', 'false'); }
  vsInfo.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = vsTip.hidden;
    vsTip.hidden = !open;
    vsInfo.setAttribute('aria-expanded', String(open));
  });
  document.addEventListener('click', (e) => {
    if (!vsTip.hidden && !vsTip.contains(e.target) && e.target !== vsInfo) closeVsTip();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !vsTip.hidden) closeVsTip(); });

  initTapTips();

  // ---- the trend-line ⓘ, same popover the view legend uses ------------------
  const emaInfo = document.getElementById('ema-info');
  const emaTip = document.getElementById('ema-tip');
  if (emaInfo && emaTip) {
    emaInfo.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = emaTip.hidden;
      emaTip.hidden = !open;
      emaInfo.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('click', (e) => {
      if (!emaTip.hidden && !emaTip.contains(e.target) && e.target !== emaInfo) {
        emaTip.hidden = true; emaInfo.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // ---- the introduction, dismissed once and for all -------------------------
  const howtoEl = document.getElementById('howto');
  const howtoX = document.getElementById('howto-x');
  const howtoReopen = document.getElementById('howto-reopen');
  function setHowto(on) {
    document.documentElement.setAttribute('data-howto', on ? 'on' : 'off');
    try { localStorage.setItem('howto', on ? 'on' : 'off'); } catch (err) {}
  }
  if (howtoX) howtoX.addEventListener('click', () => { setHowto(false); howtoReopen.focus(); });
  if (howtoReopen) howtoReopen.addEventListener('click', () => {
    setHowto(true);
    howtoEl.scrollIntoView({ block: 'nearest' });
    howtoX.focus();
  });

  // At 390px the descriptive placeholder truncates mid-word ("Search company nan").
  // Three steps, set by what actually fits: "Search company…" needs 141px of text
  // room and only has 119px at 390, so the short form starts below 410.
  const mqTiny = window.matchMedia('(max-width: 409px)');
  const syncPlaceholder = () => {
    searchEl.placeholder = mqTiny.matches ? 'Search…'
      : mqMobile.matches ? 'Search company…' : 'Search company name or symbol…';
  };
  mqMobile.addEventListener('change', syncPlaceholder);
  mqTiny.addEventListener('change', syncPlaceholder);
  syncPlaceholder();

  // Sync both switches to whatever was restored before paint.
  document.querySelectorAll('.dens .seg').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.density === density)));
  if (readURL()) dropdowns.forEach((d) => d.repaint());
  apply();
  handleHash();
  window.addEventListener('hashchange', handleHash);
  window.addEventListener('popstate', () => { clearControls(); readURL(); apply(); });
</script>
