---
import '@fontsource-variable/inter';
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Admin · Aadil Kadiwal Research</title>
    <script is:inline>try{var t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t);}catch(e){}</script>
    <style>
      .admin-wrap { max-width: 620px; margin: 48px auto; padding: 0 24px; }
      .admin-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r-md); box-shadow: var(--shadow); padding: 28px; }
      .admin-h { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
      .admin-h .mark { width: 32px; height: 32px; border-radius: 9px; background: var(--accent); color: #fff; font-weight: 800; font-size: 15px; display: inline-flex; align-items: center; justify-content: center; }
      .admin-h h1 { font-size: 20px; margin: 0; }
      .admin-sub { color: var(--muted); font-size: var(--fs-secondary); margin: 0 0 22px; }
      .field { margin: 16px 0; }
      .field label { display: block; font-size: var(--fs-label); font-weight: 700; text-transform: uppercase; letter-spacing: .4px; color: var(--muted); margin-bottom: 6px; }
      .field input[type=text], .field input[type=date] { width: 100%; }
      .field input[type=file] { font-size: var(--fs-secondary); }
      .hint { color: var(--muted); font-size: var(--fs-label); margin-top: 6px; }
      .row2 { display: flex; gap: 12px; } .row2 .field { flex: 1; }
      .who { display: flex; align-items: center; justify-content: space-between; font-size: var(--fs-secondary); margin-bottom: 18px; color: var(--muted); }
      .who b { color: var(--text); }
      #result { margin-top: 18px; padding: 14px 16px; border-radius: var(--r-sm); font-size: var(--fs-secondary); display: none; }
      #result.ok { background: var(--view-positive-bg); color: var(--view-positive-fg); display: block; }
      #result.err { background: var(--view-negative-bg); color: var(--view-negative-fg); display: block; }
      .big { width: 100%; height: 44px; font-size: var(--fs-body); }
      a.plain { color: var(--accent); }
    </style>
  </head>
  <body>
    <div class="admin-wrap">
      <div class="admin-card">
        <div class="admin-h"><span class="mark">AK</span><h1>Data admin</h1></div>
        <p class="admin-sub">Upload a quarter's research sheet — it merges into <code>companies.json</code> and publishes.
          New companies are added, a new quarter is appended to history, and re-uploading the same quarter replaces that quarter's note.</p>

        <!-- signed-out -->
        <div id="signedout" hidden>
          <p class="admin-sub">Sign in with GitHub to continue. Only the authorised account can publish.</p>
          <a class="btn primary big" href="/api/login" style="display:inline-flex">Sign in with GitHub</a>
        </div>

        <!-- signed-in -->
        <div id="signedin" hidden>
          <div class="who"><span>Signed in as <b id="who-login"></b></span><a class="plain" href="/api/logout">Sign out</a></div>
          <form id="upload-form">
            <div class="field">
              <label for="file">Research sheet (.xlsx)</label>
              <input type="file" id="file" accept=".xlsx" required />
              <div class="hint">Column headers must match exactly — <a class="plain" href="/research-sheet-template.xlsx" download>download the template</a>. Columns: CompanyName · Industry · MarketCap · Tier · TradingView Code · View · Note.</div>
            </div>
            <div class="field">
              <label for="quarter">Quarter</label>
              <input class="search" type="text" id="quarter" placeholder="Q1 FY27" required />
              <div class="hint">Must match the report folder, e.g. <code>Q1-FY27</code>.</div>
            </div>
            <button class="btn primary big" id="submit" type="submit">Upload &amp; publish</button>
          </form>
          <div id="result"></div>
        </div>
      </div>
    </div>

    <script is:inline>
      const $ = (id) => document.getElementById(id);
      const result = $('result');
      function show(cls, html) { result.className = cls; result.innerHTML = html; }

      fetch('/api/me').then((r) => r.ok ? r.json() : Promise.reject()).then((u) => {
        $('signedin').hidden = false;
        $('who-login').textContent = u.login;
      }).catch(() => { $('signedout').hidden = false; });

      $('upload-form')?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const file = $('file').files[0];
        const quarter = $('quarter').value.trim();
        if (!file || !quarter) return;
        $('submit').disabled = true; show('', 'Uploading & merging…'); result.className = ''; result.style.display = 'block'; result.textContent = 'Uploading & merging…';
        try {
          const fileBase64 = await new Promise((res, rej) => { const fr = new FileReader(); fr.onload = () => res(String(fr.result).split(',')[1]); fr.onerror = rej; fr.readAsDataURL(file); });
          const r = await fetch('/api/update', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ fileBase64, quarter }) });
          const j = await r.json();
          if (!r.ok) throw new Error(j.error || ('HTTP ' + r.status));
          show('ok', `✓ Published <b>${quarter}</b>. ${j.quarterUpserts} companies (${j.added} new), ${j.reportsLinked} report links, ${j.totalCompanies} total. The site rebuilds in ~1 minute.`);
        } catch (err) {
          show('err', '✕ ' + err.message);
        } finally { $('submit').disabled = false; }
      });
    </script>
  </body>
</html>
